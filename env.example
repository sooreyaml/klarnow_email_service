# Server Configuration
PORT=3000
NODE_ENV=development

# API Security
API_KEY=your-secure-api-key-here

# cPanel Configuration
CPANEL_HOST=your-cpanel-host.com
CPANEL_USER=your-cpanel-username
CPANEL_API_TOKEN=your-cpanel-api-token

# Resend Configuration (Email Service)
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=Your Company Name

# IMAP/SMTP Settings (for welcome email)
IMAP_HOST=mail.your-domain.com
IMAP_PORT=993
SMTP_HOST_OUT=mail.your-domain.com
SMTP_PORT_OUT=587
WEBMAIL_URL=https://webmail.your-domain.com
